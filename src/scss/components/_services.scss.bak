.section-head {
  text-align: center;
  margin-bottom: 52px;

  &__title {
    font-family: var(--lp-font-heading);
    font-size: clamp(26px, 3.6vw, 38px);
    font-weight: 700;
    color: var(--lp-text);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 14px;
  }

  &__text {
    font-size: 15px;
    color: var(--lp-text-light);
    max-width: 540px;
    margin: 0 auto;
    line-height: 1.75;
  }

  &--light &__title {
    color: #fff;
  }
  &--light &__text {
    color: rgba(255, 255, 255, 0.7);
  }
}

.services {
  padding: 80px 0;
  background: var(--lp-band-warm);

  &__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  &__card {
    border-radius: var(--lp-radius-lg);
    background: var(--lp-bg-card);
    border: 1px solid var(--lp-border);
    position: relative;
    cursor: pointer;
    &::after {
      content: "";
      width: 100%;
      height: 100%;
      top: 0;
      left: 0;
      position: absolute;
      border-radius: var(--lp-radius-lg);
      box-shadow: 0 5px 20px var(--lp-shadow-card-hover-color);
      opacity: 0;
      transition: opacity 0.3s ease;
      pointer-events: none;
      z-index: -1;
    }

    &:hover::after {
      opacity: 1;
    }
  }

  &__card-img {
    height: 200px;
    overflow: hidden;
    border-radius: var(--lp-radius-lg) var(--lp-radius-lg) 0 0;
    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  &__card-body {
    padding: 22px 22px 24px;

    h3 {
      font-family: var(--lp-font-heading);
      font-size: 19px;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--lp-text);
      margin-bottom: 8px;
      user-select: none;
    }

    p {
      font-size: 14px;
      color: var(--lp-text-light);
      line-height: 1.6;
      user-select: none;
    }
  }
}
